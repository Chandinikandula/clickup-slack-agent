# Copy to .env and fill in. Never commit .env.

# --- Slack ---------------------------------------------------------------
# Bot User OAuth Token, from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-
# App-Level Token with connections:write, from Basic Information
SLACK_APP_TOKEN=xapp-
# Your own Slack member ID — the digest is DM'd here
SLACK_USER_ID=U000000000

# --- ClickUp -------------------------------------------------------------
# Personal API token, from Settings > Apps
CLICKUP_API_TOKEN=pk_
# Workspace (team) id — the number in your ClickUp URL
CLICKUP_TEAM_ID=
# Your ClickUp user id, used to filter tasks assigned to you
CLICKUP_USER_ID=
# Comma-separated list ids to leave out of digests and agent results.
# Everything else is included, so a new Space is picked up automatically.
CLICKUP_EXCLUDE_LIST_IDS=
# Set this to restrict to specific lists instead; it wins over the exclude list.
CLICKUP_INCLUDE_LIST_IDS=

# --- LLM -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-
LLM_MODEL=claude-sonnet-5

# --- Behaviour -----------------------------------------------------------
TIMEZONE=Asia/Kolkata
DIGEST_HOUR=9
DIGEST_MINUTE=30
